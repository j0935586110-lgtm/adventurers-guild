{
  "rewrites": [
    {
      "source": "/oauth/consent",
      "destination": "/index.html"
    },
    {
      "source": "/me",
      "destination": "/index.html"
    },
    {
      "source": "/adventurers/:id",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/oauth/consent",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
