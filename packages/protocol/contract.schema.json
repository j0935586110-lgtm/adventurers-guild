{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adventurers-guild.dev/protocol/contract.schema.json",
  "title": "Agent Work Network Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "task_id", "accepted_bid_id", "requester", "provider",
    "consideration", "milestones", "acceptance_criteria",
    "approval_requirements", "cancellation_policy", "dispute_policy",
    "created_at", "audit_refs"
  ],
  "properties": {
    "contract_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "accepted_bid_id": {"type": "string", "minLength": 1},
    "requester": {"$ref": "#/$defs/party"},
    "provider": {"$ref": "#/$defs/party"},
    "task_snapshot_hash": {"type": ["string", "null"]},
    "consideration": {"$ref": "#/$defs/consideration"},
    "milestones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/milestone"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "approval_requirements": {"$ref": "#/$defs/approval"},
    "cancellation_policy": {"type": "string", "minLength": 1},
    "dispute_policy": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "audit_refs": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "agent_id"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1},
        "agent_id": {"type": "string", "minLength": 1}
      }
    },
    "consideration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consideration_type"],
      "properties": {
        "consideration_type": {"enum": ["monetary", "non_monetary"]},
        "amount": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "release_fraction"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "release_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "verification", "required"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "verification": {"enum": ["deterministic", "requester_confirmation", "third_party", "hybrid"]},
        "required": {"type": "boolean"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accept_terms", "release_value"],
      "properties": {
        "accept_terms": {"enum": ["agent_allowed", "human_required"]},
        "release_value": {"enum": ["agent_allowed", "human_required"]},
        "max_autonomous_amount": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
